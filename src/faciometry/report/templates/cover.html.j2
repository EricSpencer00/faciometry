{#- The cover page, for the browser's own print-to-PDF.

    Rendered from the same `Cover` object the reportlab renderer draws from, so
    the two paginated artifacts open on the same words and the same count. It
    is a fragment, injected at the top of the screen report by
    `report.pdf.render_print_html`, and it is hidden on screen: a document
    somebody is scrolling does not need a title page.
-#}
<div class="pcover" role="doc-cover">
  <div class="pcover__head">
    <h1 class="pcover__wordmark">Faciometry</h1>
    <span class="pcover__kind">morphometric report</span>
    <span class="pcover__date">{{ cover.generated_at }}</span>
  </div>

  <div class="pcover__tally">
    <span class="pcover__ratio">{{ cover.shown }}<span>/{{ cover.attempted }}</span></span>
    <span class="pcover__caption">{{ cover.caption }}</span>
  </div>

  <h2 class="pcover__subject">{{ cover.subject }}</h2>

  <p class="pcover__standfirst">{{ cover.standfirst }}</p>

  <dl class="pcover__rows">
    {% for key, value in cover.rows %}
    <dt>{{ key }}</dt><dd>{{ value }}</dd>
    {% endfor %}
  </dl>
</div>
